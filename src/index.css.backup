@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap');
@import "tailwindcss";
@import "tw-animate-css";
@import "shadcn/tailwind.css";
@import "@fontsource-variable/geist";

@custom-variant dark (&:is(.dark *));

:root {
  --bg-void: #09090b;
  --bg-surface: #111113;
  --bg-elevated: #1a1a1d;
  --border-subtle: #232326;
  --border-default: #333538;
  --border-hover: #45474c;
  --accent-blue: #3b82f6;
  --accent-blue-rgb: 59, 130, 246;
  --accent-cyan: #22d3ee;
  --accent-cyan-rgb: 34, 211, 238;

  --text-primary: #fafafa;
  --text-secondary: #a1a1aa;
  --text-muted: #63636e;

  --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  --font-mono: 'JetBrains Mono', monospace;

  --transition-fast: 200ms cubic-bezier(0.16, 1, 0.3, 1);
  --transition-smooth: 300ms cubic-bezier(0.16, 1, 0.3, 1);
  --transition-slow: 500ms cubic-bezier(0.16, 1, 0.3, 1);

  --section-spacing-desktop: 120px;
  --section-spacing-tablet: 90px;
  --section-spacing-mobile: 60px;

  --container-max: 1260px;
  --container-padding-desktop: 32px;
  --container-padding-mobile: 20px;
}

/* Reset and base styles */
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
}

body {
  background-color: var(--bg-void);
  color: var(--text-primary);
  font-family: var(--font-sans);
  font-size: 16px;
  line-height: 1.6;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
}

/* Custom Scrollbar */
::-webkit-scrollbar {
  width: 8px;
}

::-webkit-scrollbar-track {
  background: var(--bg-void);
}

::-webkit-scrollbar-thumb {
  background: var(--border-color);
  border-radius: 4px;
}

::-webkit-scrollbar-thumb:hover {
  background: var(--border-hover);
}

/* Layout Container */
.portfolio-wrapper {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 24px 80px 24px;
  position: relative;
}

/* Floating Navigation Header */
.nav-header {
  position: sticky;
  top: 0;
  z-index: 100;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px 0;
  background-color: rgba(7, 9, 13, 0.8);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid rgba(34, 43, 58, 0.3);
  margin-bottom: 40px;
}

.nav-logo {
  font-family: var(--font-mono);
  font-size: 14px;
  font-weight: 700;
  letter-spacing: 2px;
  color: var(--text-primary);
  text-transform: uppercase;
  display: flex;
  align-items: center;
  gap: 8px;
  text-decoration: none;
}

.nav-logo::before {
  content: '';
  display: inline-block;
  width: 8px;
  height: 8px;
  background-color: var(--accent);
  border-radius: 50%;
  box-shadow: 0 0 10px var(--accent);
}

.nav-links {
  display: flex;
  gap: 24px;
}

.nav-link {
  color: var(--text-secondary);
  text-decoration: none;
  font-size: 14px;
  font-weight: 500;
  transition: var(--transition-smooth);
}

.nav-link:hover {
  color: var(--text-primary);
}

/* Loading Experience */
.loader-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: var(--bg-void);
  z-index: 9999;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  transition: opacity 0.5s ease-out;
}

.loader-overlay.fade-out {
  opacity: 0;
  pointer-events: none;
}

.loader-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.loader-name {
  font-size: 32px;
  font-weight: 800;
  letter-spacing: 4px;
  color: var(--text-primary);
  text-transform: uppercase;
  margin-bottom: 6px;
  animation: loader-fade-in 0.8s ease-out forwards;
}

.loader-subtitle {
  font-size: 15px;
  font-weight: 500;
  letter-spacing: 2px;
  color: var(--secondary);
  text-transform: uppercase;
  margin-bottom: 40px;
  opacity: 0;
  animation: loader-fade-in 0.8s ease-out 0.3s forwards;
}

.loader-progress-container {
  width: 280px;
  height: 2px;
  background-color: var(--border-color);
  border-radius: 2px;
  position: relative;
  overflow: hidden;
  margin-bottom: 16px;
}

.loader-progress-bar {
  height: 100%;
  width: 0%;
  background: linear-gradient(90deg, var(--accent), var(--secondary));
  transition: width 0.1s linear;
}

.loader-status-text {
  font-family: var(--font-mono);
  font-size: 11px;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 1px;
  height: 16px;
}

@keyframes loader-fade-in {
  from {
    opacity: 0;
    transform: translateY(10px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Cinematic Hero Section */
.hero-section {
  display: grid;
  grid-template-columns: 1.2fr 0.8fr;
  gap: 48px;
  align-items: center;
  padding: 40px 0 80px 0;
}

.hero-left {
  display: flex;
  flex-direction: column;
}

.hero-title {
  font-size: 64px;
  font-weight: 800;
  letter-spacing: -2px;
  line-height: 1.05;
  margin-bottom: 16px;
  background: linear-gradient(135deg, #ffffff 40%, var(--text-secondary));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.hero-subtitles {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-bottom: 24px;
}

.hero-subtitle-badge {
  font-family: var(--font-mono);
  font-size: 12px;
  font-weight: 500;
  color: var(--accent);
  background-color: rgba(56, 189, 248, 0.08);
  border: 1px solid rgba(56, 189, 248, 0.15);
  padding: 4px 12px;
  border-radius: 20px;
}

.hero-subtitle-badge:nth-child(even) {
  color: var(--secondary);
  background-color: rgba(167, 139, 250, 0.08);
  border: 1px solid rgba(167, 139, 250, 0.15);
}

.hero-description {
  font-size: 18px;
  color: var(--text-secondary);
  max-width: 540px;
  margin-bottom: 40px;
  line-height: 1.6;
}

.hero-buttons {
  display: flex;
  gap: 16px;
  flex-wrap: wrap;
}

.btn-primary {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background-color: var(--text-primary);
  color: var(--bg-void);
  font-weight: 600;
  font-size: 15px;
  padding: 12px 24px;
  border-radius: 8px;
  text-decoration: none;
  border: none;
  cursor: pointer;
  transition: var(--transition-smooth);
}

.btn-primary:hover {
  background-color: #ffffff;
  transform: translateY(-2px);
  box-shadow: 0 4px 20px rgba(255, 255, 255, 0.1);
}

.btn-secondary {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background-color: transparent;
  color: var(--text-secondary);
  font-weight: 600;
  font-size: 15px;
  padding: 12px 24px;
  border-radius: 8px;
  text-decoration: none;
  border: 1px solid var(--border-color);
  cursor: pointer;
  transition: var(--transition-smooth);
}

.btn-secondary:hover {
  color: var(--text-primary);
  background-color: var(--panel-surface);
  border-color: var(--border-hover);
  transform: translateY(-2px);
}

.hero-right {
  display: flex;
  justify-content: flex-end;
  align-items: center;
}

.hero-image-wrapper {
  position: relative;
  width: 100%;
  max-width: 380px;
  aspect-ratio: 0.85;
  border-radius: 16px;
  padding: 1px;
  background: linear-gradient(135deg, var(--border-color), rgba(56, 189, 248, 0.2), var(--border-color));
}

.hero-image-container {
  width: 100%;
  height: 100%;
  border-radius: 15px;
  overflow: hidden;
  position: relative;
  background-color: var(--panel-surface);
}

.hero-image-container img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: var(--transition-smooth);
}

.hero-image-wrapper:hover .hero-image-container img {
  transform: scale(1.03);
}

.hero-image-glow {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border-radius: 16px;
  pointer-events: none;
  box-shadow: 0 0 40px rgba(56, 189, 248, 0.08);
  transition: var(--transition-smooth);
}

.hero-image-wrapper:hover .hero-image-glow {
  box-shadow: 0 0 50px rgba(56, 189, 248, 0.15), 0 0 20px rgba(167, 139, 250, 0.1);
}

/* Elegant Statistics Section */
.statistics-section {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
  padding: 40px 0;
  border-top: 1px solid var(--border-color);
  border-bottom: 1px solid var(--border-color);
  margin-bottom: 80px;
}

.stat-item {
  display: flex;
  flex-direction: column;
  padding: 16px 24px;
  position: relative;
}

.stat-item::after {
  content: '';
  position: absolute;
  right: -12px;
  top: 20%;
  height: 60%;
  width: 1px;
  background-color: var(--border-color);
}

.stat-item:last-child::after {
  display: none;
}

.stat-number {
  font-size: 44px;
  font-weight: 800;
  line-height: 1.1;
  margin-bottom: 8px;
  background: linear-gradient(135deg, var(--accent), var(--secondary));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  letter-spacing: -1px;
}

.stat-label {
  font-family: var(--font-mono);
  font-size: 11px;
  font-weight: 500;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 2px;
  margin-bottom: 4px;
}

.stat-detail {
  font-size: 14px;
  color: var(--text-secondary);
}

/* Section Header Typography */
.section-header-container {
  margin-bottom: 40px;
}

.section-label {
  font-family: var(--font-mono);
  font-size: 11px;
  font-weight: 600;
  color: var(--secondary);
  text-transform: uppercase;
  letter-spacing: 3px;
  display: block;
  margin-bottom: 12px;
}

.section-title {
  font-size: 32px;
  font-weight: 700;
  letter-spacing: -0.5px;
  color: var(--text-primary);
}

/* Editorial Content Layout */
.editorial-grid {
  display: flex;
  flex-direction: column;
  gap: 80px;
}

/* Projects Column Redesign */
.projects-container {
  display: flex;
  flex-direction: column;
  gap: 48px;
}

.projects-group-title {
  font-size: 14px;
  font-family: var(--font-mono);
  color: var(--text-secondary);
  letter-spacing: 2px;
  text-transform: uppercase;
  border-bottom: 1px solid var(--border-color);
  padding-bottom: 12px;
  margin-bottom: 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.projects-group-count {
  font-size: 12px;
  color: var(--text-muted);
}

.case-studies-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24px;
}

/* Formling full-width if needed */
.case-studies-grid.ml-grid {
  grid-template-columns: repeat(3, 1fr);
}

/* Premium Case Study Card */
.case-study-card {
  background-color: var(--panel-surface);
  border: 1px solid var(--border-color);
  border-radius: 12px;
  padding: 32px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: 100%;
  position: relative;
  overflow: hidden;
  transition: var(--transition-smooth);
}

.case-study-card:hover {
  transform: translateY(-4px);
  border-color: rgba(56, 189, 248, 0.4);
  box-shadow: 0 10px 30px rgba(7, 9, 13, 0.6), 0 0 20px rgba(56, 189, 248, 0.03);
}

.case-study-header {
  margin-bottom: 20px;
}

.case-study-impact-tag {
  font-family: var(--font-mono);
  font-size: 11px;
  font-weight: 600;
  color: var(--accent);
  background-color: rgba(56, 189, 248, 0.08);
  border: 1px solid rgba(56, 189, 248, 0.15);
  padding: 3px 10px;
  border-radius: 4px;
  display: inline-block;
  margin-bottom: 16px;
  text-transform: uppercase;
}

.case-study-title {
  font-size: 20px;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 8px;
}

.case-study-summary {
  font-size: 14px;
  color: var(--text-secondary);
  line-height: 1.5;
}

.case-study-footer {
  margin-top: 32px;
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.case-study-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.case-study-tag {
  font-family: var(--font-mono);
  font-size: 11px;
  color: var(--text-muted);
  background-color: rgba(34, 43, 58, 0.25);
  border: 1px solid rgba(34, 43, 58, 0.6);
  padding: 2px 8px;
  border-radius: 4px;
}

.case-study-link {
  font-size: 13px;
  font-weight: 600;
  color: var(--text-primary);
  display: inline-flex;
  align-items: center;
  gap: 6px;
  text-decoration: none;
  cursor: pointer;
  transition: var(--transition-smooth);
}

.case-study-link span {
  transition: transform 0.2s ease;
}

.case-study-link:hover {
  color: var(--accent);
}

.case-study-link:hover span {
  transform: translateX(4px);
}

/* Layout Split for Timeline & Technical Leadership */
.experiences-split {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 48px;
}

/* Premium Vertical Timeline */
.timeline-section-title {
  font-size: 22px;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 32px;
  display: flex;
  align-items: center;
  gap: 12px;
}

.timeline-container {
  position: relative;
  padding-left: 24px;
}

.timeline-container::before {
  content: '';
  position: absolute;
  left: 3px;
  top: 4px;
  bottom: 4px;
  width: 1px;
  background-color: var(--border-color);
}

.timeline-node {
  position: relative;
  margin-bottom: 40px;
}

.timeline-node:last-child {
  margin-bottom: 0;
}

.timeline-dot {
  position: absolute;
  left: -24.5px;
  top: 6px;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background-color: var(--accent);
  border: 2px solid var(--bg-void);
  box-shadow: 0 0 8px var(--accent);
  transition: var(--transition-smooth);
}

.timeline-node:hover .timeline-dot {
  background-color: var(--secondary);
  box-shadow: 0 0 10px var(--secondary);
}

.timeline-meta {
  display: flex;
  align-items: baseline;
  gap: 12px;
  margin-bottom: 6px;
}

.timeline-scheme {
  font-size: 16px;
  font-weight: 700;
  color: var(--text-primary);
}

.timeline-rank {
  font-family: var(--font-mono);
  font-size: 11px;
  font-weight: 600;
  color: var(--secondary);
  background-color: rgba(167, 139, 250, 0.08);
  border: 1px solid rgba(167, 139, 250, 0.15);
  padding: 1px 8px;
  border-radius: 4px;
  text-transform: uppercase;
}

.timeline-branch {
  font-family: var(--font-mono);
  font-size: 11px;
  font-weight: 500;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 1px;
}

.timeline-images {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
  margin-top: 32px;
}

.timeline-image-frame {
  border-radius: 12px;
  border: 1px solid var(--border-color);
  padding: 8px;
  background-color: var(--panel-surface);
  transition: var(--transition-smooth);
}

.timeline-image-frame:hover {
  border-color: var(--border-hover);
  transform: translateY(-2px);
}

.timeline-image-frame img {
  width: 100%;
  height: auto;
  border-radius: 8px;
  display: block;
}

.timeline-image-caption {
  font-family: var(--font-mono);
  font-size: 10px;
  color: var(--text-muted);
  margin-top: 8px;
  text-align: center;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

/* Astra Leadership redesign */
.leadership-experience-card {
  background-color: var(--panel-surface);
  border: 1px solid var(--border-color);
  border-radius: 12px;
  padding: 32px;
  height: 100%;
}

.leadership-role-title {
  font-size: 18px;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 4px;
}

.leadership-role-organization {
  font-family: var(--font-mono);
  font-size: 12px;
  font-weight: 500;
  color: var(--accent);
  text-transform: uppercase;
  letter-spacing: 1px;
  margin-bottom: 24px;
}

.leadership-bullets {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-bottom: 32px;
}

.leadership-bullets li {
  position: relative;
  padding-left: 24px;
  font-size: 14px;
  color: var(--text-secondary);
}

.leadership-bullets li::before {
  content: '✓';
  position: absolute;
  left: 0;
  top: 1px;
  color: var(--accent);
  font-weight: bold;
}

.leadership-credential-frame {
  border-radius: 12px;
  border: 1px solid var(--border-color);
  padding: 12px;
  background-color: var(--bg-void);
  transition: var(--transition-smooth);
}

.leadership-credential-frame:hover {
  border-color: var(--border-hover);
}

.leadership-credential-frame img {
  width: 100%;
  height: auto;
  border-radius: 8px;
  display: block;
}

.leadership-credential-caption {
  font-family: var(--font-mono);
  font-size: 10px;
  color: var(--text-muted);
  margin-top: 10px;
  text-align: center;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

/* Interactive Drawer Modal */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(7, 9, 13, 0.4);
  backdrop-filter: blur(8px);
  z-index: 1000;
  display: flex;
  justify-content: flex-end;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
}

.modal-overlay.open {
  opacity: 1;
  pointer-events: auto;
}

.modal-drawer {
  width: 100%;
  max-width: 680px;
  height: 100%;
  background-color: var(--panel-surface);
  border-left: 1px solid var(--border-color);
  box-shadow: -10px 0 40px rgba(0, 0, 0, 0.5);
  display: flex;
  flex-direction: column;
  transform: translateX(100%);
  transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}

.modal-overlay.open .modal-drawer {
  transform: translateX(0);
}

.modal-header {
  padding: 24px 32px;
  border-bottom: 1px solid var(--border-color);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.modal-title-group {
  display: flex;
  flex-direction: column;
}

.modal-title {
  font-size: 22px;
  font-weight: 700;
  color: var(--text-primary);
}

.modal-subtitle {
  font-size: 13px;
  color: var(--accent);
}

.modal-close-btn {
  background: none;
  border: none;
  color: var(--text-secondary);
  cursor: pointer;
  padding: 8px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: var(--transition-smooth);
}

.modal-close-btn:hover {
  background-color: var(--border-color);
  color: var(--text-primary);
}

.modal-body {
  flex-grow: 1;
  overflow-y: auto;
  padding: 32px;
}

/* Markdown parsed layout in modal body */
.markdown-container {
  color: var(--text-secondary);
  font-size: 15px;
  line-height: 1.7;
}

.markdown-container h1,
.markdown-container h2,
.markdown-container h3 {
  color: var(--text-primary);
  font-weight: 700;
  margin-top: 28px;
  margin-bottom: 12px;
}

.markdown-container h1 {
  font-size: 24px;
}

.markdown-container h2 {
  font-size: 20px;
}

.markdown-container h3 {
  font-size: 16px;
  font-family: var(--font-mono);
  color: var(--secondary);
  text-transform: uppercase;
  letter-spacing: 1px;
}

.markdown-container p {
  margin-bottom: 16px;
}

.markdown-container ul {
  list-style: none;
  margin-bottom: 24px;
}

.markdown-container li {
  position: relative;
  padding-left: 20px;
  margin-bottom: 8px;
}

.markdown-container li::before {
  content: '→';
  position: absolute;
  left: 0;
  color: var(--accent);
}

/* Animations for Section Reveal */
.reveal-element {
  opacity: 0;
  transform: translateY(20px);
  transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
}

.reveal-element.revealed {
  opacity: 1;
  transform: translateY(0);
}

/* Footer Section */
.minimal-footer {
  border-top: 1px solid var(--border-color);
  padding-top: 40px;
  margin-top: 80px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: var(--text-muted);
  font-size: 13px;
}

.footer-credits {
  font-family: var(--font-mono);
  font-size: 11px;
}

/* Responsive Overrides */
@media (max-width: 1024px) {
  .hero-section {
    grid-template-columns: 1fr;
    gap: 32px;
    padding: 20px 0 60px 0;
  }

  .hero-left {
    text-align: center;
    align-items: center;
  }

  .hero-title {
    font-size: 48px;
  }

  .hero-description {
    margin: 0 auto 32px auto;
  }

  .hero-buttons {
    justify-content: center;
  }

  .hero-right {
    justify-content: center;
  }

  .hero-image-wrapper {
    max-width: 300px;
  }

  .case-studies-grid {
    grid-template-columns: 1fr !important;
  }

  .experiences-split {
    grid-template-columns: 1fr;
    gap: 40px;
  }
}

@media (max-width: 768px) {
  .statistics-section {
    grid-template-columns: 1fr;
    gap: 16px;
  }

  .stat-item {
    padding: 12px 16px;
    align-items: center;
    text-align: center;
  }

  .stat-item::after {
    display: none;
  }

  .nav-header {
    flex-direction: column;
    gap: 16px;
    padding: 16px 0;
  }
}

/* Custom Portfolio Actions & Skills CSS */
.case-study-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16px;
  width: 100%;
}

.case-study-github-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-family: var(--font-sans);
  font-size: 13px;
  font-weight: 600;
  color: var(--text-secondary);
  text-decoration: none;
  border: 1px solid var(--border-color);
  padding: 6px 12px;
  border-radius: 6px;
  transition: var(--transition-smooth);
}

.case-study-github-btn:hover {
  color: var(--text-primary);
  border-color: var(--border-hover);
  background-color: var(--panel-hover);
  transform: translateY(-1px);
}

.skill-group {
  margin-bottom: 8px;
}

.skill-group-title {
  margin-bottom: 8px;
}

@media (max-width: 576px) {
  .case-study-actions {
    flex-direction: column;
    align-items: stretch;
    gap: 12px;
  }

  .case-study-github-btn {
    justify-content: center;
  }
}

@theme inline {
  --font-heading: var(--font-sans);
  --font-sans: 'Geist Variable', sans-serif;
  --color-sidebar-ring: var(--sidebar-ring);
  --color-sidebar-border: var(--sidebar-border);
  --color-sidebar-accent-foreground: var(--sidebar-accent-foreground);
  --color-sidebar-accent: var(--sidebar-accent);
  --color-sidebar-primary-foreground: var(--sidebar-primary-foreground);
  --color-sidebar-primary: var(--sidebar-primary);
  --color-sidebar-foreground: var(--sidebar-foreground);
  --color-sidebar: var(--sidebar);
  --color-chart-5: var(--chart-5);
  --color-chart-4: var(--chart-4);
  --color-chart-3: var(--chart-3);
  --color-chart-2: var(--chart-2);
  --color-chart-1: var(--chart-1);
  --color-ring: var(--ring);
  --color-input: var(--input);
  --color-border: var(--border);
  --color-destructive: var(--destructive);
  --color-accent-foreground: var(--accent-foreground);
  --color-accent: var(--accent);
  --color-muted-foreground: var(--muted-foreground);
  --color-muted: var(--muted);
  --color-secondary-foreground: var(--secondary-foreground);
  --color-secondary: var(--secondary);
  --color-primary-foreground: var(--primary-foreground);
  --color-primary: var(--primary);
  --color-popover-foreground: var(--popover-foreground);
  --color-popover: var(--popover);
  --color-card-foreground: var(--card-foreground);
  --color-card: var(--card);
  --color-foreground: var(--foreground);
  --color-background: var(--background);
  --radius-sm: calc(var(--radius) * 0.6);
  --radius-md: calc(var(--radius) * 0.8);
  --radius-lg: var(--radius);
  --radius-xl: calc(var(--radius) * 1.4);
  --radius-2xl: calc(var(--radius) * 1.8);
  --radius-3xl: calc(var(--radius) * 2.2);
  --radius-4xl: calc(var(--radius) * 2.6);
}

.dark {
  --background: oklch(0.145 0 0);
  --foreground: oklch(0.985 0 0);
  --card: oklch(0.205 0 0);
  --card-foreground: oklch(0.985 0 0);
  --popover: oklch(0.205 0 0);
  --popover-foreground: oklch(0.985 0 0);
  --primary: oklch(0.922 0 0);
  --primary-foreground: oklch(0.205 0 0);
  --secondary: oklch(0.269 0 0);
  --secondary-foreground: oklch(0.985 0 0);
  --muted: oklch(0.269 0 0);
  --muted-foreground: oklch(0.708 0 0);
  --accent: oklch(0.269 0 0);
  --accent-foreground: oklch(0.985 0 0);
  --destructive: oklch(0.704 0.191 22.216);
  --border: oklch(1 0 0 / 10%);
  --input: oklch(1 0 0 / 15%);
  --ring: oklch(0.556 0 0);
  --chart-1: oklch(0.87 0 0);
  --chart-2: oklch(0.556 0 0);
  --chart-3: oklch(0.439 0 0);
  --chart-4: oklch(0.371 0 0);
  --chart-5: oklch(0.269 0 0);
  --sidebar: oklch(0.205 0 0);
  --sidebar-foreground: oklch(0.985 0 0);
  --sidebar-primary: oklch(0.488 0.243 264.376);
  --sidebar-primary-foreground: oklch(0.985 0 0);
  --sidebar-accent: oklch(0.269 0 0);
  --sidebar-accent-foreground: oklch(0.985 0 0);
  --sidebar-border: oklch(1 0 0 / 10%);
  --sidebar-ring: oklch(0.556 0 0);
}

@layer base {
  * {
    @apply border-border outline-ring/50;
  }
  body {
    @apply bg-background text-foreground;
  }
  html {
    @apply font-sans;
  }
}

/* ========================================
   ABOUT SECTION
   ======================================== */
.about-content {
  display: flex;
  flex-direction: column;
  gap: 20px;
  margin-top: 24px;
}

.about-description {
  font-size: 16px;
  color: var(--text-secondary);
  line-height: 1.65;
  max-width: 780px;
}

.about-highlights {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
  margin-top: 8px;
}

.highlight-card {
  background-color: var(--panel-surface);
  border: 1px solid var(--border-color);
  border-radius: 12px;
  padding: 24px;
  display: flex;
  align-items: flex-start;
  gap: 16px;
  transition: var(--transition-smooth);
}

.highlight-card:hover {
  border-color: var(--border-hover);
  transform: translateY(-2px);
}

.highlight-icon {
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 10px;
  background: linear-gradient(135deg, rgba(56, 189, 248, 0.08), rgba(167, 139, 250, 0.08));
  border: 1px solid rgba(56, 189, 248, 0.1);
  color: var(--accent);
  flex-shrink: 0;
}

.highlight-content {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.highlight-value {
  font-size: 22px;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.2;
}

.highlight-label {
  font-family: var(--font-mono);
  font-size: 11px;
  font-weight: 600;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 1px;
}

.highlight-subtext {
  font-size: 13px;
  color: var(--text-secondary);
}

/* ========================================
   SKILLS SECTION
   ======================================== */
.skills-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20px;
  margin-top: 24px;
}

.skill-card {
  background-color: var(--panel-surface);
  border: 1px solid var(--border-color);
  border-radius: 12px;
  padding: 24px;
  display: flex;
  flex-direction: column;
  gap: 12px;
  transition: var(--transition-smooth);
}

.skill-card:hover {
  border-color: var(--border-hover);
  transform: translateY(-2px);
}

.skill-card-title {
  font-family: var(--font-mono);
  font-size: 12px;
  font-weight: 600;
  color: var(--accent);
  text-transform: uppercase;
  letter-spacing: 1px;
}

.skill-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.skill-badge {
  font-family: var(--font-mono);
  font-size: 12px;
  color: var(--text-secondary);
  background-color: rgba(34, 43, 58, 0.35);
  border: 1px solid var(--border-color);
  padding: 4px 10px;
  border-radius: 6px;
  transition: var(--transition-smooth);
}

.skill-badge:hover {
  border-color: var(--border-hover);
  color: var(--text-primary);
  background-color: rgba(34, 43, 58, 0.6);
}

/* ========================================
   EXPERIENCE SECTION
   ======================================== */
.experience-card {
  background-color: var(--panel-surface);
  border: 1px solid var(--border-color);
  border-radius: 12px;
  padding: 32px;
  transition: var(--transition-smooth);
}

.experience-card:hover {
  border-color: var(--border-hover);
}

.experience-header {
  display: flex;
  align-items: flex-start;
  gap: 16px;
  margin-bottom: 24px;
  flex-wrap: wrap;
}

.experience-icon {
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 10px;
  background: linear-gradient(135deg, rgba(56, 189, 248, 0.08), rgba(167, 139, 250, 0.08));
  border: 1px solid rgba(56, 189, 248, 0.1);
  color: var(--accent);
  flex-shrink: 0;
}

.experience-role {
  font-size: 18px;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 4px;
}

.experience-org {
  font-family: var(--font-mono);
  font-size: 12px;
  font-weight: 500;
  color: var(--accent);
  text-transform: uppercase;
  letter-spacing: 1px;
}

.experience-duration {
  margin-left: auto;
  font-family: var(--font-mono);
  font-size: 11px;
  color: var(--text-muted);
  text-transform: uppercase;
  padding-top: 4px;
}

.experience-bullets {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-bottom: 24px;
}

.experience-bullets li {
  position: relative;
  padding-left: 24px;
  font-size: 14px;
  color: var(--text-secondary);
  line-height: 1.6;
}

.experience-bullets li::before {
  content: '✓';
  position: absolute;
  left: 0;
  top: 1px;
  color: var(--accent);
  font-weight: bold;
}

.experience-labels {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.experience-label {
  font-family: var(--font-mono);
  font-size: 11px;
  color: var(--text-muted);
  background-color: rgba(34, 43, 58, 0.3);
  border: 1px solid var(--border-color);
  padding: 3px 10px;
  border-radius: 20px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.experience-linkedin-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-family: var(--font-sans);
  font-size: 13px;
  font-weight: 600;
  color: var(--accent);
  text-decoration: none;
  padding: 8px 16px;
  border-radius: 8px;
  border: 1px solid rgba(56, 189, 248, 0.2);
  background-color: rgba(56, 189, 248, 0.05);
  transition: var(--transition-smooth);
  align-self: flex-start;
}

.experience-linkedin-btn:hover {
  background-color: rgba(56, 189, 248, 0.1);
  border-color: rgba(56, 189, 248, 0.35);
  transform: translateY(-1px);
}

/* ========================================
   LEADERSHIP SECTION
   ======================================== */
.leadership-card {
  background-color: var(--panel-surface);
  border: 1px solid var(--border-color);
  border-radius: 12px;
  padding: 32px;
  transition: var(--transition-smooth);
}

.leadership-card:hover {
  border-color: rgba(56, 189, 248, 0.25);
  box-shadow: 0 0 30px rgba(56, 189, 248, 0.04);
}

.leadership-header {
  display: flex;
  align-items: flex-start;
  gap: 16px;
  margin-bottom: 24px;
  flex-wrap: wrap;
}

.leadership-icon {
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 10px;
  background: linear-gradient(135deg, rgba(56, 189, 248, 0.08), rgba(167, 139, 250, 0.08));
  border: 1px solid rgba(56, 189, 248, 0.1);
  color: var(--accent);
  flex-shrink: 0;
}

.leadership-role {
  font-size: 18px;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 4px;
}

.leadership-org {
  font-family: var(--font-mono);
  font-size: 12px;
  font-weight: 500;
  color: var(--accent);
  text-transform: uppercase;
  letter-spacing: 1px;
}

.leadership-duration {
  margin-left: auto;
  font-family: var(--font-mono);
  font-size: 11px;
  color: var(--text-muted);
  text-transform: uppercase;
  padding-top: 4px;
}

.leadership-bullets {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-bottom: 24px;
}

.leadership-bullets li {
  position: relative;
  padding-left: 24px;
  font-size: 14px;
  color: var(--text-secondary);
  line-height: 1.6;
}

.leadership-bullets li::before {
  content: '✓';
  position: absolute;
  left: 0;
  top: 1px;
  color: var(--accent);
  font-weight: bold;
}

.leadership-areas {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-bottom: 24px;
}

.leadership-area-tag {
  font-family: var(--font-mono);
  font-size: 11px;
  color: var(--secondary);
  background-color: rgba(167, 139, 250, 0.08);
  border: 1px solid rgba(167, 139, 250, 0.15);
  padding: 3px 10px;
  border-radius: 20px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.leadership-credential-frame {
  border-radius: 12px;
  border: 1px solid var(--border-color);
  padding: 12px;
  background-color: var(--bg-void);
  transition: var(--transition-smooth);
}

.leadership-credential-frame:hover {
  border-color: var(--border-hover);
}

.leadership-credential-frame img {
  width: 100%;
  height: auto;
  max-height: 280px;
  object-fit: cover;
  border-radius: 8px;
  display: block;
}

.leadership-credential-caption {
  font-family: var(--font-mono);
  font-size: 10px;
  color: var(--text-muted);
  margin-top: 10px;
  text-align: center;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

/* ========================================
   CASE STUDY ENHANCEMENTS
   ======================================== */
.case-study-section {
  margin-top: 12px;
}

.case-study-section-label {
  font-family: var(--font-mono);
  font-size: 10px;
  font-weight: 600;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 1px;
  display: block;
  margin-bottom: 6px;
}

.case-study-text {
  font-size: 13px;
  color: var(--text-secondary);
  line-height: 1.55;
  margin: 0;
}

/* ========================================
   CONTACT SECTION
   ======================================== */
.contact-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
  margin-top: 24px;
}

.contact-card {
  background-color: var(--panel-surface);
  border: 1px solid var(--border-color);
  border-radius: 12px;
  padding: 24px;
  display: flex;
  align-items: flex-start;
  gap: 16px;
  text-decoration: none;
  transition: var(--transition-smooth);
}

.contact-card:hover {
  border-color: var(--border-hover);
  transform: translateY(-2px);
  background-color: var(--panel-hover);
}

.contact-icon {
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 10px;
  background: linear-gradient(135deg, rgba(56, 189, 248, 0.08), rgba(167, 139, 250, 0.08));
  border: 1px solid rgba(56, 189, 248, 0.1);
  color: var(--accent);
  flex-shrink: 0;
}

.contact-content {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.contact-label {
  font-family: var(--font-mono);
  font-size: 10px;
  font-weight: 600;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 1px;
}

.contact-value {
  font-size: 14px;
  color: var(--text-secondary);
}

.contact-card:hover .contact-value {
  color: var(--text-primary);
}

/* ========================================
   RESPONSIVE OVERRIDES
   ======================================== */
@media (max-width: 1024px) {
  .skills-grid {
    grid-template-columns: 1fr;
  }

  .about-highlights {
    grid-template-columns: repeat(3, 1fr);
  }

  .contact-grid {
    grid-template-columns: 1fr;
  }

  .experience-duration,
  .leadership-duration {
    margin-left: 0;
    width: 100%;
    padding-top: 0;
  }
}

@media (max-width: 768px) {
  .about-highlights {
    grid-template-columns: 1fr;
  }

  .skills-grid {
    grid-template-columns: 1fr;
  }

  .contact-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 576px) {
  .experience-header,
  .leadership-header {
    flex-direction: column;
    gap: 12px;
  }

  .experience-duration,
  .leadership-duration {
    margin-left: 0;
  }
}
